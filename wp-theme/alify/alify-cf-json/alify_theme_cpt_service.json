{
    "format": "alify-local-json",
    "version": 1,
    "schema_version": 12,
    "key": "alify_theme_cpt_service",
    "status": "draft",
    "group": {
        "title": "ALIFY Service — Card, Single Stats & Deliverables",
        "location": "alify_service",
        "rules": [],
        "fields": [
            {
                "name": "svc_tab_card",
                "label": "Service Card & Archive",
                "type": "tab"
            },
            {
                "name": "svc_notch",
                "label": "Notch Code Badge",
                "type": "text",
                "instructions": "Example: 01 · WEB"
            },
            {
                "name": "svc_tag",
                "label": "Discipline Pill Label",
                "type": "text",
                "instructions": "Example: Engineering"
            },
            {
                "name": "svc_filter",
                "label": "Archive Filter Tab",
                "type": "select",
                "instructions": "",
                "default": "engineering",
                "choices": "design : Design & Brand\nengineering : Web & Engineering\ngrowth : Growth, CRO & SEO"
            },
            {
                "name": "svc_icon",
                "label": "Font Awesome Icon Class",
                "type": "text",
                "instructions": "Example: fa-solid fa-code"
            },
            {
                "name": "svc_bg_img",
                "label": "Upload Card & Single Hero Image (Media Library)",
                "type": "image",
                "instructions": "Pick an image from Media Library to override the starter image URL."
            },
            {
                "name": "svc_bg_url",
                "label": "Current / Fallback Image URL",
                "type": "text",
                "instructions": ""
            },
            {
                "name": "svc_points_rows",
                "label": "Card Bullet Deliverables (Repeater)",
                "type": "repeater",
                "instructions": "",
                "sub_fields": [
                    {
                        "name": "point",
                        "label": "Deliverable Bullet Text",
                        "type": "text",
                        "instructions": ""
                    }
                ],
                "max_rows": 12
            },
            {
                "name": "svc_tab_single",
                "label": "Single Page Stats & Bento Deliverables",
                "type": "tab"
            },
            {
                "name": "svc_stats_rows",
                "label": "Single Hero Stats (Repeater)",
                "type": "repeater",
                "instructions": "",
                "sub_fields": [
                    {
                        "name": "val",
                        "label": "Stat Value (e.g. 99+)",
                        "type": "text",
                        "instructions": ""
                    },
                    {
                        "name": "label",
                        "label": "Stat Label (e.g. Core Web Vitals)",
                        "type": "text",
                        "instructions": ""
                    }
                ],
                "max_rows": 6
            },
            {
                "name": "svc_deliv_rows",
                "label": "Single Page Deliverable Bento Cards (Repeater)",
                "type": "repeater",
                "instructions": "",
                "sub_fields": [
                    {
                        "name": "icon",
                        "label": "Font Awesome Icon (e.g. fa-solid fa-bolt)",
                        "type": "text",
                        "instructions": "",
                        "default": "fa-solid fa-layer-group"
                    },
                    {
                        "name": "title",
                        "label": "Deliverable Card Title",
                        "type": "text",
                        "instructions": ""
                    },
                    {
                        "name": "desc",
                        "label": "Deliverable Card Description",
                        "type": "textarea",
                        "instructions": ""
                    }
                ],
                "max_rows": 12
            },
            {
                "name": "svc_stack_pills",
                "label": "Single Page Tech Stack Pills (comma-separated)",
                "type": "text",
                "instructions": "Example: HTML5 & CSS3, GSAP ScrollTrigger, WordPress Custom CMS, Technical Schema"
            }
        ]
    }
}
